{
    "name": "pandaleague/jsonschemabuilder",
    "authors": [
        {
            "name": "IAmEd"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/pandaleague/jsonschemabuilder"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PandaLeague\\JsonSchemaBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PandaLeague\\JsonSchemaBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
